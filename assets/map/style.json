{
  "version": 8,
  "name": "WorkyDay Minimal Australia",
  "metadata": {
    "workyday:source": "pmtiles://https://maps.workyday.com/australia.pmtiles",
    "workyday:design_intent": "Google Maps-inspired minimal basemap with low visual noise so custom WorkyDay markers remain the primary focus.",
    "workyday:validated_source_layers": [
      "boundaries",
      "earth",
      "landcover",
      "landuse",
      "places",
      "pois",
      "roads",
      "water"
    ],
    "workyday:needs_validation": [
      "places.kind values assumed: country, region, locality",
      "roads.kind values assumed: highway, major_road, minor_road, rail",
      "landuse.kind values assumed: park, national_park, forest, wood, grassland, grass, playground, village_green, protected_area, nature_reserve",
      "water.kind values assumed: water, lake, river, stream",
      "boundaries.kind_detail assumed numeric ranking where lower values are stronger administrative boundaries"
    ],
    "workyday:glyphs_note": "Text layers assume the current MapLibre runtime can resolve glyphs for the declared font stack. If labels do not render, the minimal follow-up is to add a local or remote glyphs endpoint."
  },
  "center": [133.0, -25.0],
  "zoom": 3.8,
  "sources": {
    "australia": {
      "type": "vector",
      "url": "pmtiles://https://maps.workyday.com/australia.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#cfe1ec"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "australia",
      "source-layer": "earth",
      "filter": [
