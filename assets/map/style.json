      ],
      "paint": {
        "fill-color": "#dbe6d5",
        "fill-opacity": 0.62
      }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "australia",
      "source-layer": "landuse",
      "filter": [
